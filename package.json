{
  "name": "taghvim-safari",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "serve -s dist -l tcp://0.0.0.0:${PORT:-3000}",
    "test": "node scripts/run-tests.mjs",
    "build:server": "tsc -p server/tsconfig.json",
    "start:api": "node server/dist/index.js",
